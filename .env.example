# Network: leave unset (defaults to Base Sepolia, 84532). Set to 8453 to
# target Base Mainnet once the app is production-ready.
NEXT_PUBLIC_CHAIN_ID=84532

# RPC endpoints. Public endpoints are fine for local dev; use a dedicated
# provider (or self-hosted node) before any real production traffic.
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Filled in after `forge script script/DeployTipJar.s.sol --broadcast`.
NEXT_PUBLIC_TIP_JAR_ADDRESS=0x6fd261311DA2d2C34Fc8150a23d6e6aB04AaF7A5

# OnchainKit API key (used for Basename resolution). Get one from the
# Coinbase Developer Platform dashboard — see docs.cdp.coinbase.com.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Your registered Base Builder Code (see docs.base.org, Builder Codes /
# ERC-8021). Leave unset locally — tips still work, they're just not
# attributed yet.
NEXT_PUBLIC_BUILDER_CODE=

# Only needed for deployment (forge script --account). Never commit a
# real private key. Prefer `cast wallet import deployer --interactive`
# over putting a raw key in .env.
# PRIVATE_KEY=
